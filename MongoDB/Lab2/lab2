from pymongo import MongoClient
import pprint

client = MongoClient("mongodb://localhost:27017/")
db = client["webshop"]

print("---------------Exercise 1-------------------")
products1 = db.products.find({"price": {"$gte" : 1000}}, {"_id": 0, "name" : 1, "price" : 1})
for product in products1:
    pprint.pp(product)

print("---------------Exercise 2-------------------")
orders2 = db.orders.find({"status" : {"$ne" : "delivered"}}, {"_id" : 1, "status" : 1})
for order in orders2:
    pprint.pp(order)

print("---------------Exercise 3-------------------")
customers3 = db.customers.find({"city" : {"$in": ("Stockholm", "Malmö")}}, {"first_name" : 1, "last_name" : 1, "city" : 1})
for customer in customers3:
    pprint.pp(customer)